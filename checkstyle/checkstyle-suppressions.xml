<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.0//EN"
    "https://checkstyle.org/dtds/suppressions_1_0.dtd">

<!--
    Google Java Style is now enforced on all files under src/main/java.
    Add a <suppress .../> entry here only if a specific file must be exempted.
-->
<suppressions>
    <!-- Our packages follow the course's ca-login layout (data_access, use_case,
         interface_adapter), which uses underscores. Google style forbids them,
         so only the PackageName rule is turned off. -->
    <suppress checks="PackageName" files=".*"/>
</suppressions>
